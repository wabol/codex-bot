# Required: use tokens from the dedicated Codex Bot Slack app, not OpenClaw.
SLACK_BOT_TOKEN=xoxb-your-new-codex-bot-token
SLACK_APP_TOKEN=xapp-your-new-codex-bot-socket-token

CODEX_BOT_WORKDIR=
CODEX_BOT_MODEL=
CODEX_BOT_DISABLE_FEATURES=apps,plugins
CODEX_BOT_TIMEOUT_MS=1800000
CODEX_BOT_MAX_SLACK_CHARS=3500
CODEX_BOT_LOG_RETENTION_DAYS=30
CODEX_BOT_SESSION_RETENTION_DAYS=180
CODEX_BOT_ALLOWED_USERS=
CODEX_BOT_ALLOWED_CHANNELS=
CODEX_BOT_ALLOW_ALL_USERS=false
CODEX_BOT_REQUIRE_MENTION=true
CODEX_BOT_ENABLE_CHANNEL_PREFIX=true
CODEX_BOT_WORKING_REACTION=eyes
CODEX_BOT_ACTIVE_REACTION=hourglass_flowing_sand
CODEX_BOT_DONE_REACTION=white_check_mark
CODEX_BOT_ERROR_REACTION=x
CODEX_BOT_DRY_RUN=false
